# Copy this file to .env and adjust values before running docker compose in any
# shared or production-like environment. Never commit a real .env file.

POSTGRES_DB=flashcard_db
POSTGRES_USER=flashcard_user
POSTGRES_PASSWORD=flashcard_pass

# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-super-secret-key-in-production-min-32-chars
JWT_EXPIRATION_MS=86400000
